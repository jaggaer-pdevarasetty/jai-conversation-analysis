# Server
PORT=3000

# Chat DB — READ-ONLY (SELECT). Never used for writes.
CHAT_DB_URL=postgresql://readonly:***@host:5432/jai?sslmode=require

# LangSmith (read) — authoritative for tokens + latency
LANGSMITH_API_KEY=
LANGSMITH_BASE_URL=https://api.smith.langchain.com
LANGSMITH_PROJECT=jai-orchestrator

# LLM (Gemini)
GEMINI_API_KEY=

# Our own result store (the ONLY thing we write to)
RESULT_STORE=sqlite://./data/analysis.db
