# Server
PORT=3000

# Chat DB — READ-ONLY (SELECT). Never used for writes.
CHAT_DB_URL=postgresql://readonly:***@host:5432/jai?sslmode=require

# LangSmith (read) — authoritative for tokens + latency
LANGSMITH_API_KEY=
LANGSMITH_BASE_URL=https://api.smith.langchain.com
LANGSMITH_PROJECT=jai-orchestrator

# LLM (Gemini)
GEMINI_API_KEY=

# Our own result store (the ONLY thing we write to)
RESULT_STORE=sqlite://./data/analysis.db

# ── Multi-region + multi-environment (READ-ONLY chat DBs) ──────────────────────────
# The app supports two environments selectable from a UI toggle: UIT (default) and PROD.
# Each environment has one or more regional chat DBs. Results are stored in ONE results DB,
# tagged with the environment so UIT and PROD never mix.
#
# UIT (default env — no prefix):
#   REGIONS=us,eu,uk
#   REGION_US_CHAT_DB_URL=postgresql+psycopg://readonly:***@us-host:5432/db?sslmode=require
#   REGION_US_CHAT_DB_NAME=jai_agentos_uit          # optional; falls back to CHAT_DB_NAME
#   REGION_US_CHAT_DB_SCHEMA=jai_agentos_schema_uit # optional; falls back to CHAT_DB_SCHEMA
#   REGION_US_LANGSMITH_PROJECT=uit_us              # optional; default is uit_<region>
#   (repeat for EU, UK)
#
# PROD (prefix every var with PROD_; default LangSmith project is prod_<region>):
#   PROD_REGIONS=us,eu,uk
#   PROD_REGION_US_CHAT_DB_URL=postgresql+psycopg://readonly:***@prod-us-host:5432/db?sslmode=require
#   PROD_REGION_US_CHAT_DB_NAME=...
#   PROD_REGION_US_CHAT_DB_SCHEMA=...
#   PROD_REGION_US_LANGSMITH_PROJECT=prod_us
#   PROD_LANGSMITH_API_KEY=                          # optional; falls back to the UIT key
#   (repeat for EU, UK)
#
# NOTE: until real PROD credentials exist you can point PROD_* at the UIT values to test the
# toggle end-to-end. PROD only analyses conversations that have user feedback (bulk) or that a
# reviewer explicitly picks (per-conversation button); it never auto-analyses everything.
