# ── JAI Conversation Analysis — env (repo root: jai-conversation-analysis/.env) ──
# The server loads this file from the REPO ROOT (not server/). Never commit real secrets
# (.env is gitignored). Copy the vars you need into ../.env at the repo root.

# Conversation source: "fixtures" (samples, no creds) | "chatdb" (REAL) | "langsmith".
SOURCE=fixtures

# Chat DB — READ ONLY (SELECT). Required when SOURCE=chatdb.
# The real conversations live in DB `jai_agentos_uit`, schema `jai_agentos_schema_uit`.
# CHAT_DB_NAME overrides the DB in the URL (so a URL pointing at the schema name still works).
CHAT_DB_URL=
CHAT_DB_NAME=jai_agentos_uit
CHAT_DB_SCHEMA=jai_agentos_schema_uit
CHATDB_LIMIT=200
# Single-region label for the record tag (when using CHAT_DB_URL above).
REGION_LABEL=uk

# MULTI-REGION (option C): pull + centralise all regions, each record tagged with its region.
# Set REGIONS and, per label, REGION_<LABEL>_CHAT_DB_URL (+ optional _CHAT_DB_NAME / _CHAT_DB_SCHEMA
# which fall back to CHAT_DB_NAME / CHAT_DB_SCHEMA). Overrides the single CHAT_DB_URL above.
#   REGIONS=us,eu,uk
#   REGION_US_CHAT_DB_URL=postgresql+psycopg://user:pass@us-host:5432/db
#   REGION_EU_CHAT_DB_URL=postgresql+psycopg://user:pass@eu-host:5432/db
#   REGION_UK_CHAT_DB_URL=postgresql+psycopg://user:pass@uk-host:5432/db

# LangSmith (read) — tokens/latency. Behind Zscaler, DO NOT disable TLS; instead point at
# the corporate root CA and proxy via the env vars below (safe, verified TLS).
LANGSMITH_BASE_URL=https://api.smith.langchain.com   # EU accounts: https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=uit_us          # real projects: prelogin_uit | uit_us | uit_eu | uit_uk
LANGSMITH_LIMIT=100

# Zscaler / corporate TLS: on macOS & Windows leave REQUESTS_CA_BUNDLE UNSET — the app uses
# the OS trust store (truststore), which already trusts the Zscaler root CA (verified TLS,
# never disabled). Only set REQUESTS_CA_BUNDLE on Linux/GCP if you need an explicit bundle.
# REQUESTS_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
# HTTPS_PROXY=http://your-proxy:port

# Gemini via VERTEX AI ONLY (enterprise). Vertex uses OAuth2 (service account / ADC) —
# NOT an API key. Classification runs only when BOTH project and location are set;
# otherwise the deterministic rules are used.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GEMINI_MODEL=gemini-2.5-flash

# Common store — PostgreSQL (podman/Docker). SQLite is NOT used for storing data.
#   podman:  podman run -d --name jai-analysis-postgres -e POSTGRES_USER=jai \
#            -e POSTGRES_PASSWORD=jai -e POSTGRES_DB=analysis -p 5433:5432 postgres:16-alpine
#   docker:  docker compose -f docker-compose.postgres.yml up -d
STORE_BACKEND=sql
RESULTS_DB_URL=postgresql+psycopg://jai:jai@localhost:5433/analysis

# Reviewer RBAC gate (send header "X-Roles: reviewer" when enabled).
RBAC_ENABLED=false

# Analysis behaviour
BATCH_SIZE=10               # conversations per LLM call
SCHEDULE_HOURS=4            # auto-analyse sweep cadence (0 disables)
LAZY_ANALYZE=true          # analyse a user's conversations when a reviewer opens them
MAX_ANALYSES_PER_DAY=3     # on-demand re-analyse cap per conversation

# Privacy: "admin" (tenant/user shown — analytics) or "pooled" (AC-10: pseudonymised, no
# per-tenant drill-down). Content PII is scrubbed in BOTH modes.
PRIVACY_MODE=admin
