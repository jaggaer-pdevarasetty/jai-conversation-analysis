# ── JAI Conversation Analysis — server (FastAPI) ──
# Copy to server/.env for local runs. Never commit real secrets.

# Chat DB — READ ONLY (SELECT). Leave empty to run on built-in fixtures.
CHAT_DB_URL=

# LangSmith (read) — authoritative tokens/latency + intent/frustration signals.
LANGSMITH_BASE_URL=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jai-orchestrator

# Gemini classifier. Empty → deterministic rule-based classification (fallback).
GEMINI_API_KEY=

# Common store: "memory" (default, non-persistent) or "sql" (persistent).
#   SQLite (no Docker):   STORE_BACKEND=sql  RESULTS_DB_URL=sqlite:///./data/analysis.db
#   Postgres (Docker):    docker compose -f docker-compose.postgres.yml up -d
#                         STORE_BACKEND=sql
#                         RESULTS_DB_URL=postgresql+psycopg://jai:jai@localhost:5433/analysis
STORE_BACKEND=memory
RESULTS_DB_URL=sqlite:///./data/analysis.db

# Reviewer RBAC gate (send header "X-Roles: reviewer" when enabled).
RBAC_ENABLED=false
